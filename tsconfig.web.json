{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Renderer: DOM available, Node globals deliberately absent. The renderer
    // is sandboxed and reaches the main process only through the preload
    // bridge, so it has no business seeing `process` or `require`.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "outDir": ".tsbuild/web",
    "tsBuildInfoFile": ".tsbuild/web.tsbuildinfo"
  },
  "include": ["src/app/**/*.ts", "src/app/**/*.tsx", "src/views/**/*.tsx", "src/skins/**/*.tsx"],
  "references": [{ "path": "./tsconfig.core.json" }]
}
