# Vuelta environment pinning — the "virtualenv" contract.
#
# engine-strict: refuse to install under a Node version this project does not
# declare support for, instead of printing a warning nobody reads.
engine-strict=true

# save-exact: no "^" drift. Every dependency is pinned to an exact version,
# so package.json alone is a reproducible manifest (the requirements.txt role).
save-exact=true

# Never auto-install peer deps silently; surface conflicts instead.
# The Vite 7 / plugin-react 5 pairing in this project is deliberate and a
# silent peer resolution would quietly undo it.
legacy-peer-deps=false
