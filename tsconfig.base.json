{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Declaration-only emit into a throwaway directory. Nothing here ships —
    // electron-vite does the real bundling. This exists so `tsc --build` can
    // treat the three layers as separate projects and cache them incrementally.
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true
  }
}
